parameters:
    level: 8
    # The oldest PHP Signage Forge supports (RHEL 9, Debian 12).
    phpVersion: 80200
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php # generated by Symfony
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
