# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
#
# Signage Forge supports three engines. SQLite is the zero-config default:
# DATABASE_URL="mysql://signageforge:!ChangeMe!@127.0.0.1:3306/signageforge?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://signageforge:!ChangeMe!@127.0.0.1:5432/signageforge?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
# Only used when SIGNAGEFORGE_REALTIME=mercure. See docs/deployment.md.
# URL the app publishes to (can be internal)
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
# URL browsers (the screens) connect to; must be on the same domain as Signage Forge
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Shared secret with the hub (publisher and subscriber JWT key)
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ISSUER=signageforge
###< symfony/mercure-bundle ###

###> signageforge ###
# Where uploaded media is stored (an "uploads" folder is created inside).
SIGNAGEFORGE_DATA_DIR="%kernel.project_dir%/data"

# How screens learn about changes:
#   polling  screens re-check every SIGNAGEFORGE_POLL_INTERVAL seconds (works anywhere)
#   mercure  instant push through a Mercure hub (see MERCURE_* above)
SIGNAGEFORGE_REALTIME=polling
SIGNAGEFORGE_POLL_INTERVAL=15

# Comma-separated IPs/CIDRs of your reverse proxy, e.g. "127.0.0.1,REMOTE_ADDR".
TRUSTED_PROXIES=

# Role given to people the first time they sign in (LDAP, Microsoft 365, or a
# local account created without a role): VIEWER, EDITOR or ADMIN. Admins can
# change it later under Users. The very first account is always the OWNER.
SIGNAGEFORGE_NEW_USER_ROLE=VIEWER

# Updates. The admin "System" page checks GitHub for new releases of this
# repository; leave empty on servers that must not contact the internet.
SIGNAGEFORGE_UPDATE_REPOSITORY=KylianLab/SignageForge
# Let admins install a new release from the browser. Off by default: the web
# server then needs write access to the project folder.
SIGNAGEFORGE_WEB_UPDATES=false

# Time zone for screen schedules, e.g. Europe/Brussels. Empty: PHP's date.timezone.
SIGNAGEFORGE_TIMEZONE=

# --- Sign-in methods (all optional; the login page shows only enabled ones) ---
# Local email + password. Create users with: php bin/console signageforge:user:create
AUTH_LOCAL_PASSWORD=true

# Microsoft 365 SSO (Entra ID). Leave blank to disable. Redirect URI to register:
#   https://<your-host>/login/microsoft/check
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Your tenant id for single-tenant, or "common"/"organizations".
ENTRA_TENANT=common

# LDAP / Active Directory. Leave LDAP_URL blank to disable.
#   LDAP_URL="ldap://ldap.example.com:389"  (or ldaps://...:636)
LDAP_URL=
LDAP_BASE_DN="dc=example,dc=com"
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Attribute users type as login: "uid" for OpenLDAP, "sAMAccountName" for AD.
LDAP_LOGIN_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=cn
###< signageforge ###
