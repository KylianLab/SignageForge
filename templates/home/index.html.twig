{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block body %}
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-10 px-6 text-center">
        <div class="space-y-3">
            <div class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-4 py-1.5 text-sm font-medium text-brand">
                {{ ui.icon('cast') }} Signage Forge
            </div>
            <h1 class="text-4xl font-bold tracking-tight">Self-hosted digital signage</h1>
            <p class="text-gray-600">
                One app. Your screens are just URLs. Upload media, build a playlist,
                point a screen at it: it plays in a loop and keeps playing offline.
            </p>
        </div>

        <div class="grid w-full gap-4 sm:grid-cols-2">
            <a href="{{ path('app_dashboard') }}" class="card flex flex-col items-start gap-2 p-6 text-left transition hover:border-brand hover:shadow-sm">
                {{ ui.icon('dashboard', 'h-6 w-6 text-brand') }}
                <span class="font-semibold">Dashboard</span>
                <span class="text-sm text-gray-500">Manage screens, media and playlists.</span>
            </a>
            <a href="{{ path('app_pair') }}" data-turbo="false" class="card flex flex-col items-start gap-2 p-6 text-left transition hover:border-brand hover:shadow-sm">
                {{ ui.icon('play', 'h-6 w-6 text-brand') }}
                <span class="font-semibold">Set up a screen</span>
                <span class="text-sm text-gray-500">Open this on the display device to pair it.</span>
            </a>
        </div>
    </main>
{% endblock %}
