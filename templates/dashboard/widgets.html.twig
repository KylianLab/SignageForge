{% extends 'dashboard/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block page_title %}{{ 'Widgets'|trans }} · {{ owner.name }}{% endblock %}

{% block content %}
    {% set is_group = kind == 'groups' %}
    {% set readonly = not is_granted('ROLE_EDITOR') %}
    {% set position_names = {'top-left': 'Top left', 'top-right': 'Top right', 'bottom-left': 'Bottom left', 'bottom-right': 'Bottom right'} %}
    {% set speed_names = {slow: 'Slow', normal: 'Normal', fast: 'Fast'} %}
    <a href="{{ is_group ? path('app_groups_edit', {id: owner.id}) : path('app_screens_edit', {id: owner.id}) }}" class="mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800">
        {{ ui.icon('back') }} {{ owner.name }}
    </a>
    <h1 class="mb-2 text-2xl font-bold">{{ (is_group ? 'Widgets of the group %name%' : 'Widgets of %name%')|trans({'%name%': owner.name}) }}</h1>
    <p class="mb-6 text-sm text-gray-500">{{ (is_group ? 'Shown over the content, on every screen of the group.' : 'Shown over the content, on this screen.')|trans }}</p>

    {% if not is_group and owner.group %}
        <p class="mb-6 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
            {{ 'This screen is in the group %name% and shows the group\'s widgets. The settings below apply again if it leaves the group.'|trans({'%name%': owner.group.name}) }}
            <a href="{{ path('app_widgets', {kind: 'groups', id: owner.group.id}) }}" class="underline">{{ 'Open the group\'s widgets'|trans }}</a>
        </p>
    {% endif %}

    <form method="post" action="{{ path('app_widgets_save', {kind: kind, id: owner.id}) }}" class="space-y-4">
        <input type="hidden" name="_token" value="{{ csrf_token('widgets-' ~ owner.id) }}">

        <fieldset class="card space-y-3 p-4" {{ readonly ? 'disabled' }}>
            <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="clock" value="1" {{ overlays.clock ? 'checked' }}> {{ 'Clock'|trans }}</label>
            <div class="flex flex-wrap items-center gap-4 text-sm">
                <select name="clock_position" class="input w-auto" aria-label="{{ 'Position'|trans }}">
                    {% for position in positions %}<option value="{{ position }}" {{ overlays.clockPosition == position ? 'selected' }}>{{ position_names[position]|trans }}</option>{% endfor %}
                </select>
                <label class="flex items-center gap-2"><input type="checkbox" name="clock_show_date" value="1" {{ overlays.clockShowDate ? 'checked' }}> {{ 'Show the date'|trans }}</label>
            </div>
        </fieldset>

        <fieldset class="card space-y-3 p-4" {{ readonly ? 'disabled' }}>
            <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="weather" value="1" {{ overlays.weather ? 'checked' }} {{ weather_enabled ? '' : 'disabled' }}> {{ 'Weather'|trans }}</label>
            {% if weather_enabled %}
                <div class="flex flex-wrap items-center gap-4 text-sm">
                    <input name="weather_place" value="{{ overlays.weatherLabel }}" placeholder="{{ 'City, Country (e.g. Brussels, Belgium)'|trans }}" class="input w-72" aria-label="{{ 'Place'|trans }}">
                    <select name="weather_position" class="input w-auto" aria-label="{{ 'Position'|trans }}">
                        {% for position in positions %}<option value="{{ position }}" {{ overlays.weatherPosition == position ? 'selected' }}>{{ position_names[position]|trans }}</option>{% endfor %}
                    </select>
                </div>
                <p class="text-xs text-gray-500">{{ 'Current temperature and sky, refreshed every 15 minutes (data: Open-Meteo).'|trans }}</p>
            {% else %}
                <p class="text-xs text-gray-500">{{ 'The weather is turned off on this server (SIGNAGEFORGE_WEATHER=false).'|trans }}</p>
            {% endif %}
        </fieldset>

        <fieldset class="card space-y-3 p-4" {{ readonly ? 'disabled' }}>
            <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="ticker" value="1" {{ overlays.ticker ? 'checked' }}> {{ 'News ticker'|trans }}</label>
            <textarea name="ticker_text" rows="4" maxlength="2000" placeholder="{{ 'One message per line'|trans }}" class="input" aria-label="{{ 'Ticker messages'|trans }}">{{ overlays.tickerText }}</textarea>
            <label class="flex items-center gap-2 text-sm">{{ 'Speed'|trans }}
                <select name="ticker_speed" class="input w-auto">
                    {% for speed in speeds %}<option value="{{ speed }}" {{ overlays.tickerSpeed == speed ? 'selected' }}>{{ speed_names[speed]|trans }}</option>{% endfor %}
                </select>
            </label>
        </fieldset>

        {% if not readonly %}
            <button class="btn-primary">{{ ui.icon('save') }} {{ 'Save'|trans }}</button>
        {% endif %}
    </form>
{% endblock %}
