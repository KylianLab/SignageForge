{% extends 'dashboard/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block page_title %}{{ 'Schedule'|trans }} · {{ owner.name }}{% endblock %}

{% block content %}
    {% set is_group = kind == 'groups' %}
    <a href="{{ is_group ? path('app_groups_edit', {id: owner.id}) : path('app_screens_edit', {id: owner.id}) }}" class="mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800">
        {{ ui.icon('back') }} {{ owner.name }}
    </a>
    <h1 class="mb-2 text-2xl font-bold">
        {{ (is_group ? 'Schedule of the group %name%' : 'Schedule of %name%')|trans({'%name%': owner.name}) }}
    </h1>
    <div class="mb-6 space-y-2 text-sm text-gray-500">
        {% if not is_group and owner.group %}
            <p class="rounded-lg bg-amber-50 px-3 py-2 text-amber-900">
                {{ 'This screen is in the group %name% and plays the group\'s schedule. The rules below apply again if it leaves the group.'|trans({'%name%': owner.group.name}) }}
                <a href="{{ path('app_groups_edit', {id: owner.group.id}) }}" class="underline">{{ 'Open the group'|trans }}</a>
            </p>
        {% endif %}
        <p>
            {{ (is_group ? 'Outside these rules the screens of this group play %playlist% (the default playlist, chosen on the group page).' : 'Outside these rules the screen plays %playlist% (the default playlist, chosen on the Screens page).')|trans({'%playlist%': owner.playlist ? owner.playlist.name : 'nothing'|trans}) }}
            {{ 'When several rules match, the first one wins.'|trans }}
        </p>
    </div>

    <div class="card mb-8 divide-y divide-gray-100">
        {% for rule in owner.scheduleRules %}
            <div class="flex flex-wrap items-center gap-4 p-4">
                <span class="w-5 text-center text-xs text-gray-400">{{ loop.index }}</span>
                <div class="min-w-0 flex-1">
                    <div class="font-medium">{{ rule.playlist.name }}</div>
                    <div class="text-xs text-gray-500">{{ include('dashboard/_schedule_rule.html.twig', {rule: rule}) }}</div>
                </div>
                {% if is_granted('ROLE_EDITOR') %}
                    {% if not loop.first %}
                        <form method="post" action="{{ path('app_schedule_up', {kind: kind, id: owner.id, rule: rule.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('schedule-' ~ owner.id) }}">
                            <button class="text-gray-400 hover:text-gray-800" title="{{ 'Move up'|trans }}">{{ ui.icon('up') }}<span class="sr-only">{{ 'Move up'|trans }}</span></button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_schedule_delete', {kind: kind, id: owner.id, rule: rule.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('schedule-' ~ owner.id) }}">
                        <button class="rounded-lg p-2 text-gray-400 hover:bg-red-50 hover:text-red-600" title="{{ 'Remove'|trans }}">{{ ui.icon('trash') }}<span class="sr-only">{{ 'Remove rule'|trans }}</span></button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <p class="p-4 text-sm text-gray-500">{{ 'No rules: the default playlist always plays.'|trans }}</p>
        {% endfor %}
    </div>

    {% if is_granted('ROLE_EDITOR') %}
        <form method="post" action="{{ path('app_schedule_add', {kind: kind, id: owner.id}) }}" class="card space-y-4 p-4">
            <input type="hidden" name="_token" value="{{ csrf_token('schedule-' ~ owner.id) }}">
            <h2 class="font-semibold">{{ 'Add a rule'|trans }}</h2>
            <div>
                <label class="label" for="rule-playlist">{{ 'Play'|trans }}</label>
                <select id="rule-playlist" name="playlist" required class="input">
                    {% for playlist in playlists %}
                        <option value="{{ playlist.id }}">{{ playlist.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <fieldset>
                <legend class="label">{{ 'On'|trans }}</legend>
                <div class="flex flex-wrap gap-3">
                    {% for number, name in day_names %}
                        <label class="flex items-center gap-1 text-sm">
                            <input type="checkbox" name="days[]" value="{{ number }}" {{ number <= 5 ? 'checked' }}> {{ name|trans }}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
            <div class="flex flex-wrap items-end gap-3">
                <div><label class="label" for="rule-start">{{ 'From'|trans }}</label><input id="rule-start" name="start" type="time" value="08:00" class="input w-32"></div>
                <div><label class="label" for="rule-end">{{ 'To'|trans }}</label><input id="rule-end" name="end" type="time" value="12:00" class="input w-32"></div>
                <label class="flex items-center gap-2 pb-2 text-sm"><input type="checkbox" name="all_day" value="1"> {{ 'All day'|trans }}</label>
            </div>
            <p class="text-xs text-gray-500">{{ 'An end before the start runs overnight, e.g. 22:00 to 06:00.'|trans }}</p>
            <button class="btn-primary">{{ ui.icon('plus') }} {{ 'Add rule'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
