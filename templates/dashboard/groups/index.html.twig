{% extends 'dashboard/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block page_title %}{{ 'Groups'|trans }}{% endblock %}

{% block content %}
    <h1 class="mb-2 text-2xl font-bold">{{ 'Groups'|trans }}</h1>
    <p class="mb-6 text-sm text-gray-500">
        {{ 'Screens in a group show the same content: the group\'s playlist and schedule.'|trans }}
    </p>

    {% if is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_groups_create') }}" class="mb-8 flex gap-3">
            <input type="hidden" name="_token" value="{{ csrf_token('group-create') }}">
            <input name="name" required maxlength="80" placeholder="{{ 'New group, e.g. Lobby screens'|trans }}" class="input flex-1" aria-label="{{ 'New group name'|trans }}">
            <button class="btn-primary">{{ ui.icon('plus') }} {{ 'Create'|trans }}</button>
        </form>
    {% endif %}

    <div class="grid gap-3">
        {% for group in groups %}
            <a href="{{ path('app_groups_edit', {id: group.id}) }}" class="card flex items-center gap-4 p-4 hover:border-brand">
                {{ ui.icon('group', 'h-5 w-5 text-brand') }}
                <div class="min-w-0 flex-1">
                    <div class="truncate font-medium">{{ group.name }}</div>
                    <div class="text-xs text-gray-500">
                        {{ '%count% screen|%count% screens'|trans({'%count%': group.screens|length}) }}
                        · {{ group.playlist ? group.playlist.name : 'no playlist'|trans }}
                        {% if group.scheduleRules|length %}· {{ '%count% schedule rule|%count% schedule rules'|trans({'%count%': group.scheduleRules|length}) }}{% endif %}
                    </div>
                </div>
            </a>
        {% else %}
            <p class="text-gray-500">{{ 'No groups yet.'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
