{% extends 'dashboard/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block page_title %}{{ screen.name }}{% endblock %}

{% block content %}
    <a href="{{ path('app_dashboard') }}" class="mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800">
        {{ ui.icon('back') }} {{ 'Screens'|trans }}
    </a>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-bold">{{ screen.name }}</h1>
        <div class="flex gap-2">
            {% if not screen.group %}
                <a href="{{ path('app_schedule', {kind: 'screens', id: screen.id}) }}" class="btn-secondary">{{ ui.icon('calendar') }} {{ 'Schedule'|trans }}</a>
            {% endif %}
            <a href="{{ path('app_widgets', {kind: 'screens', id: screen.id}) }}" class="btn-secondary">{{ ui.icon('widgets') }} {{ 'Widgets'|trans }}</a>
        </div>
    </div>

    <form method="post" action="{{ path('app_screens_update', {id: screen.id}) }}" class="card mb-6 space-y-4 p-5">
        <input type="hidden" name="_token" value="{{ csrf_token('screen-' ~ screen.id) }}">
        {% set readonly = not is_granted('ROLE_ADMIN') %}
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="label" for="screen-name">{{ 'Name'|trans }}</label>
                <input id="screen-name" name="name" value="{{ screen.name }}" required maxlength="80" class="input" {{ readonly ? 'disabled' }}>
            </div>
            <div>
                <label class="label" for="screen-location">{{ 'Location'|trans }}</label>
                <input id="screen-location" name="location" value="{{ screen.location }}" maxlength="120" placeholder="{{ 'e.g. Main entrance, 1st floor'|trans }}" class="input" {{ readonly ? 'disabled' }}>
            </div>
        </div>

        <fieldset>
            <legend class="label">{{ 'How is the display mounted?'|trans }}</legend>
            <p class="mb-3 text-xs text-gray-500">
                {{ 'When a display is turned on its side but its device still sends a landscape picture, pick how it is turned and the content is rotated to read upright.'|trans }}
            </p>
            <div class="grid gap-3 sm:grid-cols-4">
                {% for orientation in orientations %}
                    {% set turned = orientation.rotation in [90, 270] %}
                    <label class="card flex cursor-pointer flex-col items-center gap-2 p-3 text-center text-xs has-[:checked]:border-brand has-[:checked]:ring-2 has-[:checked]:ring-brand/20">
                        <input type="radio" name="orientation" value="{{ orientation.value }}" class="sr-only" {{ screen.orientation == orientation ? 'checked' }} {{ readonly ? 'disabled' }}>
                        <span class="flex h-14 items-center justify-center" aria-hidden="true">
                            <span class="flex items-center justify-center rounded border-2 border-gray-400 bg-gray-50 text-gray-500 {{ turned ? 'h-14 w-9' : 'h-9 w-14' }}">
                                <span class="inline-block font-semibold" style="transform: rotate({{ orientation.rotation }}deg)">A</span>
                            </span>
                        </span>
                        {{ orientation.label|trans }}
                    </label>
                {% endfor %}
            </div>
        </fieldset>

        {% if not readonly %}
            <button class="btn-primary">{{ ui.icon('save') }} {{ 'Save'|trans }}</button>
        {% endif %}
    </form>

    <section class="card divide-y divide-gray-100 text-sm">
        <div class="flex justify-between gap-4 px-4 py-3">
            <span class="text-gray-500">{{ 'Status'|trans }}</span>
            <span>
                {% if screen.online %}
                    {{ 'Online'|trans }}
                {% elseif screen.lastSeenAt %}
                    {{ 'Offline, last seen %date%'|trans({'%date%': screen.lastSeenAt|date('Y-m-d H:i')}) }}
                {% else %}
                    {{ 'Never connected'|trans }}
                {% endif %}
            </span>
        </div>
        <div class="flex justify-between gap-4 px-4 py-3"><span class="text-gray-500">{{ 'Plays'|trans }}</span>
            <span>
                {% if screen.group %}
                    {{ 'the group'|trans }} <a href="{{ path('app_groups_edit', {id: screen.group.id}) }}" class="text-brand hover:underline">{{ screen.group.name }}</a>
                {% else %}
                    {{ screen.playlist ? screen.playlist.name : 'no playlist'|trans }}{% if screen.scheduleRules|length %}{{ ', with a schedule'|trans }}{% endif %}
                {% endif %}
            </span>
        </div>
        <div class="flex justify-between gap-4 px-4 py-3"><span class="text-gray-500">{{ 'Device'|trans }}</span><span class="truncate text-right text-xs text-gray-500" title="{{ screen.userAgent }}">{{ screen.userAgent ?? '-' }}</span></div>
        <div class="flex justify-between gap-4 px-4 py-3"><span class="text-gray-500">{{ 'Paired'|trans }}</span><span>{{ screen.createdAt|date('Y-m-d') }}</span></div>
    </section>
{% endblock %}
