{% import 'components/icons.html.twig' as ui %}
<turbo-frame id="screen-list">
    <div class="grid gap-3">
        {% for screen in screens %}
            {% set online = screen.online %}
            <div class="card flex flex-wrap items-center gap-4 p-4">
                <span class="h-3 w-3 shrink-0 rounded-full {{ online ? 'bg-green-500' : 'bg-gray-300' }}" aria-hidden="true"></span>
                <div class="min-w-0 flex-1">
                    <a href="{{ path('app_screens_edit', {id: screen.id}) }}" data-turbo-frame="_top" class="block truncate font-medium hover:text-brand">{{ screen.name }}</a>
                    <div class="text-xs text-gray-500">
                        {% if screen.location %}{{ screen.location }} · {% endif %}
                        {% if screen.orientation.rotation %}{{ screen.orientation.rotation }}° · {% endif %}
                        {% if online %}
                            {{ 'Online'|trans }}
                        {% elseif screen.lastSeenAt %}
                            {{ 'Offline · last seen %date%'|trans({'%date%': screen.lastSeenAt|date('Y-m-d H:i')}) }}
                        {% else %}
                            {{ 'Waiting for the screen to connect'|trans }}
                        {% endif %}
                    </div>
                </div>
                {% if is_granted('ROLE_ADMIN') and groups is not empty %}
                    <form method="post" action="{{ path('app_screens_group', {id: screen.id}) }}" data-controller="autosubmit" data-turbo-frame="_top">
                        <input type="hidden" name="_token" value="{{ csrf_token('screen-' ~ screen.id) }}">
                        <label class="sr-only" for="group-{{ screen.id }}">{{ 'Group of %name%'|trans({'%name%': screen.name}) }}</label>
                        <select id="group-{{ screen.id }}" name="group" class="input w-auto" data-action="autosubmit#submit">
                            <option value="">{{ 'No group'|trans }}</option>
                            {% for group in groups %}
                                <option value="{{ group.id }}" {{ screen.group and screen.group.id == group.id ? 'selected' }}>{{ group.name }}</option>
                            {% endfor %}
                        </select>
                        <noscript><button class="btn-secondary">{{ 'Save'|trans }}</button></noscript>
                    </form>
                {% endif %}
                {% if screen.group %}
                    <a href="{{ path('app_groups_edit', {id: screen.group.id}) }}" data-turbo-frame="_top" class="text-sm text-gray-600 hover:text-brand">
                        {{ 'Plays the group %name%'|trans({'%name%': screen.group.name}) }}
                    </a>
                {% elseif is_granted('ROLE_EDITOR') %}
                <form method="post" action="{{ path('app_screens_playlist', {id: screen.id}) }}" data-controller="autosubmit" data-turbo-frame="_top">
                    <input type="hidden" name="_token" value="{{ csrf_token('screen-' ~ screen.id) }}">
                    <label class="sr-only" for="playlist-{{ screen.id }}">{{ 'Playlist for %name%'|trans({'%name%': screen.name}) }}</label>
                    <select id="playlist-{{ screen.id }}" name="playlist" class="input w-auto" data-action="autosubmit#submit">
                        <option value="">{{ 'No playlist'|trans }}</option>
                        {% for playlist in playlists %}
                            <option value="{{ playlist.id }}" {{ screen.playlist and screen.playlist.id == playlist.id ? 'selected' }}>{{ playlist.name }}</option>
                        {% endfor %}
                    </select>
                    <noscript><button class="btn-secondary">{{ 'Save'|trans }}</button></noscript>
                </form>
                {% else %}
                    <span class="text-sm text-gray-600">{{ screen.playlist ? screen.playlist.name : 'No playlist'|trans }}</span>
                {% endif %}
                {% if not screen.group %}
                <a href="{{ path('app_schedule', {kind: 'screens', id: screen.id}) }}" data-turbo-frame="_top" class="btn-secondary" title="{{ 'Schedule'|trans }}">
                    {{ ui.icon('calendar') }} {{ 'Schedule'|trans }}{% if screen.scheduleRules|length %} ({{ screen.scheduleRules|length }}){% endif %}
                </a>
                {% endif %}
                <a href="{{ path('app_player', {token: screen.deviceToken}) }}" target="_blank" rel="noopener noreferrer"
                   title="{{ 'Preview in a new tab'|trans }}" class="btn-secondary" data-turbo="false">
                    {{ ui.icon('external') }} {{ 'Preview'|trans }}
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_screens_delete', {id: screen.id}) }}" data-turbo-frame="_top"
                      data-turbo-confirm="{{ 'Remove %name%? The device will need to be paired again.'|trans({'%name%': screen.name}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('screen-' ~ screen.id) }}">
                    <button title="{{ 'Remove screen'|trans }}" class="rounded-lg p-2 text-gray-400 hover:bg-red-50 hover:text-red-600">
                        {{ ui.icon('trash') }}<span class="sr-only">{{ 'Remove %name%'|trans({'%name%': screen.name}) }}</span>
                    </button>
                </form>
                {% endif %}
            </div>
        {% else %}
            <p class="text-gray-500">
                {% if is_granted('ROLE_ADMIN') %}
                    {{ 'No screens yet. Open /pair on a display, then enter its code above.'|trans }}
                {% else %}
                    {{ 'No screens yet. Open /pair on a display, then ask an admin to add it.'|trans }}
                {% endif %}
            </p>
        {% endfor %}
    </div>
</turbo-frame>
