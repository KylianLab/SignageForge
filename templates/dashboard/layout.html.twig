{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as ui %}

{% block title %}{% block page_title %}Dashboard{% endblock %} · Signage Forge{% endblock %}

{% block body %}
    {% set route = app.current_route %}
    {% set nav = [
        {route: 'app_dashboard', label: 'Screens', icon: 'monitor', active: route starts with 'app_dashboard' or route starts with 'app_screens' or route starts with 'app_schedule'},
        {route: 'app_media', label: 'Media', icon: 'image', active: route starts with 'app_media'},
        {route: 'app_playlists', label: 'Playlists', icon: 'list', active: route starts with 'app_playlists'},
    ]|merge(is_granted('ROLE_ADMIN') ? [
        {route: 'app_users', label: 'Users', icon: 'users', active: route starts with 'app_users'},
        {route: 'app_system', label: 'System', icon: 'system', active: route starts with 'app_system'},
    ] : []) %}
    <div class="flex min-h-screen flex-col md:flex-row">
        <aside class="flex shrink-0 flex-col border-b border-gray-200 bg-white p-4 md:w-60 md:border-r md:border-b-0 md:p-5">
            <a href="{{ path('app_dashboard') }}" class="mb-4 flex items-center gap-2 font-semibold md:mb-8">
                {{ ui.icon('cast', 'h-5 w-5 text-brand') }} Signage Forge
            </a>
            <nav class="flex gap-1 md:flex-col md:space-y-1">
                {% for item in nav %}
                    <a href="{{ path(item.route) }}"
                       class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm {{ item.active ? 'bg-brand/10 font-medium text-brand' : 'text-gray-700 hover:bg-gray-100' }}">
                        {{ ui.icon(item.icon) }} {{ item.label }}
                    </a>
                {% endfor %}
            </nav>
            <div class="mt-4 flex items-center justify-between gap-2 border-t border-gray-100 pt-4 md:mt-auto md:block">
                {% if app.user %}
                    <div class="truncate px-3 text-xs text-gray-500 md:mb-2" title="{{ app.user.email }}">{{ app.user.displayName }}{% if app.user.role %} · {{ app.user.role.label }}{% endif %}</div>
                {% endif %}
                <a href="{{ path('app_logout') }}" data-turbo="false" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-100">
                    {{ ui.icon('logout') }} Sign out
                </a>
            </div>
        </aside>
        <main class="flex-1 p-4 md:p-8">
            <div class="mx-auto max-w-5xl">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 rounded-lg px-4 py-3 text-sm {{ type == 'error' ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-800' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
