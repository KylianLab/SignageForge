{% extends 'install/layout.html.twig' %}

{% block step %}
    <h1 class="text-xl font-semibold">First admin</h1>
    {% if not env_writable %}
        <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
            The web server cannot write <code>{{ env_file }}</code>, so the setup will fail at this step.
            Make the project folder writable, or use <code>php bin/console signageforge:install</code>.
        </p>
    {% endif %}
    <form method="post" class="space-y-3">
        <input type="hidden" name="_token" value="{{ csrf_token('install') }}">
        <div><label class="label" for="email">Email</label><input id="email" name="email" type="email" required value="{{ email }}" autocomplete="username" class="input"></div>
        <div><label class="label" for="admin-name">Name</label><input id="admin-name" name="name" value="{{ name }}" class="input"></div>
        <div><label class="label" for="admin-password">Password (8 characters or more)</label><input id="admin-password" name="password" type="password" required minlength="8" autocomplete="new-password" class="input"></div>
        <div><label class="label" for="admin-password-repeat">Password again</label><input id="admin-password-repeat" name="password_repeat" type="password" required minlength="8" autocomplete="new-password" class="input"></div>
        <button class="btn-primary w-full">Install Signage Forge</button>
        <p class="text-xs text-gray-500">This creates the database tables and may take a minute.</p>
    </form>
{% endblock %}
