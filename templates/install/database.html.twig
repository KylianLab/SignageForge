{% extends 'install/layout.html.twig' %}

{% block step %}
    <h1 class="text-xl font-semibold">Database</h1>
    <form method="post" class="space-y-4" data-controller="install-database">
        <input type="hidden" name="_token" value="{{ csrf_token('install') }}">
        <fieldset class="space-y-2">
            <legend class="label">Where should Signage Forge keep its data?</legend>
            {% for value, label in {
                sqlite: 'SQLite: a file on this server, nothing to install. Fine for most sites.',
                mysql: 'MariaDB or MySQL',
                postgresql: 'PostgreSQL',
            } %}
                <label class="flex items-start gap-2 text-sm">
                    <input type="radio" name="engine" value="{{ value }}" {{ db.engine == value ? 'checked' }}
                           data-action="install-database#toggle" class="mt-1">
                    <span>{{ label }}</span>
                </label>
            {% endfor %}
        </fieldset>
        <div class="grid grid-cols-2 gap-3 {{ db.engine == 'sqlite' ? 'hidden' }}" data-install-database-target="server">
            <div><label class="label" for="host">Host</label><input id="host" name="host" value="{{ db.host }}" class="input"></div>
            <div><label class="label" for="port">Port</label><input id="port" name="port" value="{{ db.port }}" placeholder="default" class="input"></div>
            <div><label class="label" for="name">Database name</label><input id="name" name="name" value="{{ db.name }}" class="input"></div>
            <div><label class="label" for="user">User</label><input id="user" name="user" value="{{ db.user }}" class="input"></div>
            <div><label class="label" for="password">Password</label><input id="password" name="password" type="password" class="input"></div>
            <div><label class="label" for="server_version">Server version</label><input id="server_version" name="server_version" value="{{ db.serverVersion }}" placeholder="10.11.2-MariaDB, 8.0.36, 16" class="input"></div>
        </div>
        <button class="btn-primary w-full">Test the connection and continue</button>
    </form>
{% endblock %}
