{% extends 'install/layout.html.twig' %}

{% block step %}
    <h1>{{ 'Signage Forge is ready'|trans }}</h1>
    <ul>
        {% for line in done %}<li>{{ line|trans }}</li>{% endfor %}
    </ul>
    <p class="muted">{{ 'The setup page is now closed. Sign in as %email%, then open /pair on a screen.'|trans({'%email%': email}) }}</p>
    <a href="{{ path('app_login') }}" class="btn-primary">{{ 'Sign in'|trans }}</a>
{% endblock %}
