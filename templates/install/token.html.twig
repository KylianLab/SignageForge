{% extends 'install/layout.html.twig' %}

{% block step %}
    <h1>{{ 'Prove you run this server'|trans }}</h1>
    <p class="muted">
        {{ 'So that nobody else can set up this site before you, a setup token was written on the server. Read it there and paste it below:'|trans }}
    </p>
    <pre>cat {{ token_file }}</pre>
    {% if not env_writable %}
        <p class="alert alert-warning">
            {{ 'The web server cannot write %file%. Make the project folder writable for the setup, or use "php bin/console signageforge:install" on the server instead.'|trans({'%file%': env_file}) }}
        </p>
    {% endif %}
    <form method="post" class="stack">
        <input type="hidden" name="_token" value="{{ csrf_token('install') }}">
        <div>
            <label class="label" for="token">{{ 'Setup token'|trans }}</label>
            <input id="token" name="token" required autocomplete="off" class="input font-mono">
        </div>
        <button class="btn-primary">{{ 'Continue'|trans }}</button>
    </form>
{% endblock %}
